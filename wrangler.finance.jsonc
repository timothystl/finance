{
  // Production Finance Worker config. Release and operations: docs/OPERATIONS.md. Releases are
  // dispatched with .github/workflows/deploy-finance.yml. Finance data is only reachable behind
  // Cloudflare Access on finance.timothystl.org (Access is set in the dashboard, not here).
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "timothy-finance-app",
  "main": "apps/finance/shell.js",
  "compatibility_date": "2026-09-09",
  "workers_dev": false,
  "preview_urls": false,

  "routes": [
    { "pattern": "finance.timothystl.org", "custom_domain": true }
  ],

  "d1_databases": [
    {
      "binding": "FINANCE_DB",
      "database_name": "timothy-finance-db",
      "database_id": "04988828-94b7-43bc-9689-ff570951f1c7",
      "migrations_dir": "apps/finance/migrations"
    }
  ],

  // Facilities photos and scanned documents (apps/finance/facility-files.js). Private: files are
  // only served through the Worker's own access-checked route, never a public bucket URL.
  "r2_buckets": [
    {
      "binding": "FACILITY_FILES",
      "bucket_name": "timothy-finance-files"
    }
  ],

  "services": [
    {
      "binding": "CONNECT_SERVICE",
      "service": "timothy-connect"
    },
    {
      "binding": "PAYROLL_SERVICE",
      "service": "timothy-website-admin"
    }
  ],

  "vars": {
    "ENVIRONMENT": "production",
    "RELEASE_SHA": "unreleased",
    "FINANCE_ACCESS_TEAM_DOMAIN": "timothystl.cloudflareaccess.com",
    "FINANCE_ACCESS_AUD": "74de33dfe1e65b4eea9b8bf51e04d654e470a60773175bf34d74d55e940b66eb",
    // QuickBooks is owned by Finance when this is "1" (see docs/OPERATIONS.md).
    // FINANCE_QB_CLIENT_ID / FINANCE_QB_CLIENT_SECRET are Worker secrets, never listed here.
    "FINANCE_QB_ENABLED": "1",
    "FINANCE_QB_ENVIRONMENT": "production",
    // Report reads come straight from FINANCE_DB (the same database Connect's contracts read)
    // instead of a round trip through Connect; see apps/finance/local-contract-reads.js.
    "FINANCE_LOCAL_CONTRACT_READS": "1"
  },

  "observability": {
    "enabled": true
  }
}
